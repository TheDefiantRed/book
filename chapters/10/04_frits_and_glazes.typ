    [], [#ch("K2O")], [0.062], [], [#ch("B2O3")], [0.122], [], [#ch("S")], [0.083],
    [], [#ch("BaO")], [0.283], [], [], [], [], [], [],
    [], [#ch("ZnO")], [0.335], [], [], [], [], [], [],
